{% extends 'base.html.twig' %}

{% block title %}Nos menus - Vite & Gourmand{% endblock %}

{% block body %}

<div class="container" style="padding-top: var(--space-lg); padding-bottom: var(--space-xl);">

    <div class="d-flex justify-between align-center" style="margin-bottom: var(--space-md);">
        <h1 class="text-headline-md">Nos menus</h1>
        <span style="font-size: var(--fs-label-md); color: var(--color-on-surface-variant);" id="compteur-menus">
            {{ menus|length }} menu{{ menus|length > 1 ? 's' : '' }}
        </span>
    </div>

    <div class="filter-sidebar" style="margin-bottom: var(--space-lg);">
        <div class="grid-2" style="gap: var(--space-md);">
            <div class="form-group" style="margin-bottom:0;">
                <label for="filter-theme">Thème</label>
                <select id="filter-theme" class="form-select">
                    <option value="">Tous les thèmes</option>
                    {% for theme in themes %}
                        <option value="{{ theme.id }}">{{ theme.libelle }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-group" style="margin-bottom:0;">
                <label for="filter-regime">Régime</label>
                <select id="filter-regime" class="form-select">
                    <option value="">Tous les régimes</option>
                    {% for regime in regimes %}
                        <option value="{{ regime.id }}">{{ regime.libelle }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-group" style="margin-bottom:0;">
                <span id="label-prix-legende">
                    Prix par personne : <strong id="label-prix-max">sans limite</strong>
                </span>
                <div class="range-double">
                    <div class="range-double__track"></div>
                    <div class="range-double__fill" id="range-fill"></div>
                    <input type="range" id="filter-prix-min"
                           min="0" max="200" step="5" value="0"
                           aria-label="Prix minimum par personne">
                    <input type="range" id="filter-prix-max"
                           min="0" max="200" step="5" value="200"
                           aria-label="Prix maximum par personne">
                </div>
            </div>
            <div class="form-group" style="margin-bottom:0;">
                <label for="filter-nb-personnes">Nombre de personnes</label>
                <input type="number" id="filter-nb-personnes" placeholder="ex. 15" min="1">
            </div>
        </div>
        <div style="margin-top: var(--space-md);">
            <button type="button" id="btn-reset" class="btn-ghost" style="padding: var(--space-xs) var(--space-md);">
                Réinitialiser les filtres
            </button>
        </div>
    </div>

    <div id="menus-loading" class="grille-loading" role="status" style="display:none;">
        <span class="spinner spinner--brand" aria-hidden="true"></span>
        Chargement des menus...
    </div>

    <div class="grid-3" id="grille-menus">
        {% for menu in menus %}
            <div class="menu-col">
                <div class="card-menu">
                    <div class="card-menu__image-wrapper">
                        {% if menu.images is not empty %}
                            <img class="card-menu__image"
                                 src="{{ asset(menu.images.first.chemin) }}"
                                 alt="{{ menu.titre }}">
                        {% else %}
                            <div class="card-menu__placeholder">🍽️</div>
                        {% endif %}
                        <div class="card-menu__badges">
                            <span class="badge badge--{{ menu.theme.libelle|lower|replace({' ': '-', 'â': 'a', 'ô': 'o', 'é': 'e', 'è': 'e', 'ê': 'e', 'î': 'i', 'û': 'u', 'ï': 'i', 'ë': 'e', 'ü': 'u'}) }}">
                                {{ menu.theme.libelle }}
                            </span>
                            <span class="badge badge--{{ menu.regime.libelle|lower|replace({' ': '-', 'â': 'a', 'ô': 'o', 'é': 'e', 'è': 'e', 'ê': 'e', 'î': 'i', 'û': 'u', 'ï': 'i', 'ë': 'e', 'ü': 'u'}) }}">
                                {{ menu.regime.libelle }}
                            </span>
                        </div>
                    </div>
                    <div class="card-menu__body">
                        <h2 class="card-menu__title">{{ menu.titre }}</h2>
                        <p class="card-menu__description">{{ menu.description }}</p>
                        <div class="card-menu__meta">
                            <div>
                                <p class="card-menu__price">{{ menu.prixParPersonne }}€ / pers.</p>
                                <p class="card-menu__persons">Min. {{ menu.nombrePersonneMinimum }} personnes</p>
                            </div>
                            <a href="{{ path('app_menu_show', {id: menu.id}) }}" class="btn-ghost" style="padding: var(--space-xs) var(--space-sm); font-size: var(--fs-label-sm);">
                                Voir le menu
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <p class="text-center text-muted" style="grid-column: 1/-1; padding: var(--space-xl) 0;">
                Aucun menu disponible pour le moment.
            </p>
        {% endfor %}
    </div>

    <p class="text-center text-muted" id="msg-aucun-resultat" style="display:none; padding: var(--space-xl) 0;">
        Aucun menu ne correspond à vos critères.
    </p>

</div>

{% endblock %}

{% block javascripts %}
<script>
(function () {
    var selTheme  = document.getElementById('filter-theme');
    var selRegime = document.getElementById('filter-regime');
    var rangeMin  = document.getElementById('filter-prix-min');
    var rangePrix = document.getElementById('filter-prix-max');
    var rangeFill = document.getElementById('range-fill');
    var inputNb   = document.getElementById('filter-nb-personnes');
    var labelPrix = document.getElementById('label-prix-max');
    var compteur  = document.getElementById('compteur-menus');
    var grille    = document.getElementById('grille-menus');
    var msgAucun  = document.getElementById('msg-aucun-resultat');
    var loading   = document.getElementById('menus-loading');
    var btnReset  = document.getElementById('btn-reset');
    var urlFiltre = '{{ path('app_menus_filtrer') }}';
    var txtAucun  = msgAucun.textContent;
    var timer     = null;

    // les deux poignees ne doivent pas se croiser : celle qu'on bouge repousse l'autre
    function empecherCroisement(source) {
        var min = parseInt(rangeMin.value);
        var max = parseInt(rangePrix.value);
        if (min > max) {
            if (source === 'min') {
                rangeMin.value = max;
            } else {
                rangePrix.value = min;
            }
        }
    }

    function updateLabelPrix() {
        var min = parseInt(rangeMin.value);
        var max = parseInt(rangePrix.value);
        var txtMax = max >= 200 ? 'sans limite' : max + '€';
        labelPrix.textContent = min > 0 ? 'de ' + min + '€ à ' + txtMax : txtMax;

        // la barre coloree suit les deux poignees
        rangeFill.style.left  = (min / 200 * 100) + '%';
        rangeFill.style.width = ((max - min) / 200 * 100) + '%';
    }

    // echappe le texte venant du serveur avant de l'injecter dans du HTML
    function echapper(texte) {
        var div = document.createElement('div');
        div.textContent = texte;
        return div.innerHTML;
    }

    function carteMenu(menu) {
        var image = menu.image
            ? '<img class="card-menu__image" src="' + menu.image + '" alt="' + echapper(menu.titre) + '">'
            : '<div class="card-menu__placeholder">🍽️</div>';

        return '' +
        '<div class="menu-col">' +
          '<div class="card-menu">' +
            '<div class="card-menu__image-wrapper">' +
              image +
              '<div class="card-menu__badges">' +
                '<span class="badge badge--' + menu.theme.slug + '">' + echapper(menu.theme.libelle) + '</span>' +
                '<span class="badge badge--' + menu.regime.slug + '">' + echapper(menu.regime.libelle) + '</span>' +
              '</div>' +
            '</div>' +
            '<div class="card-menu__body">' +
              '<h2 class="card-menu__title">' + echapper(menu.titre) + '</h2>' +
              '<p class="card-menu__description">' + echapper(menu.description) + '</p>' +
              '<div class="card-menu__meta">' +
                '<div>' +
                  '<p class="card-menu__price">' + menu.prix + '€ / pers.</p>' +
                  '<p class="card-menu__persons">Min. ' + menu.nbMin + ' personnes</p>' +
                '</div>' +
                '<a href="' + menu.url + '" class="btn-ghost" style="padding: var(--space-xs) var(--space-sm); font-size: var(--fs-label-sm);">Voir le menu</a>' +
              '</div>' +
            '</div>' +
          '</div>' +
        '</div>';
    }

    function afficherMenus(menus) {
        grille.innerHTML = menus.map(carteMenu).join('');
        compteur.textContent = menus.length + ' menu' + (menus.length > 1 ? 's' : '');
        msgAucun.textContent = txtAucun;
        msgAucun.style.display = menus.length === 0 ? 'block' : 'none';
    }

    function filtrer() {
        var params = new URLSearchParams();
        if (selTheme.value)  { params.set('theme', selTheme.value); }
        if (selRegime.value) { params.set('regime', selRegime.value); }
        params.set('prixMin', rangeMin.value);
        params.set('prixMax', rangePrix.value);
        if (inputNb.value)   { params.set('nbPersonnes', inputNb.value); }

        loading.style.display = 'flex';
        grille.style.opacity = '0.4';

        fetch(urlFiltre + '?' + params.toString(), {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function (reponse) { return reponse.json(); })
        .then(function (menus) { afficherMenus(menus); })
        .catch(function () {
            grille.innerHTML = '';
            compteur.textContent = '';
            msgAucun.textContent = 'Le chargement des menus a échoué. Merci de réessayer.';
            msgAucun.style.display = 'block';
        })
        .then(function () {
            loading.style.display = 'none';
            grille.style.opacity = '1';
        });
    }

    // on attend que l'utilisateur arrete de bouger avant d'interroger le serveur
    function filtrerBientot() {
        clearTimeout(timer);
        timer = setTimeout(filtrer, 300);
    }

    function reset() {
        selTheme.value  = '';
        selRegime.value = '';
        rangeMin.value  = 0;
        rangePrix.value = 200;
        inputNb.value   = '';
        updateLabelPrix();
        filtrer();
    }

    rangeMin.addEventListener('input', function () {
        empecherCroisement('min');
        updateLabelPrix();
        filtrerBientot();
    });
    rangePrix.addEventListener('input', function () {
        empecherCroisement('max');
        updateLabelPrix();
        filtrerBientot();
    });
    selTheme.addEventListener('change', filtrer);
    selRegime.addEventListener('change', filtrer);
    inputNb.addEventListener('input', filtrerBientot);
    btnReset.addEventListener('click', reset);

    updateLabelPrix();
})();
</script>
{% endblock %}
